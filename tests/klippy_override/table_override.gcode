; A copied table in a local file replaces the whole shipped table, as the README says.
SET_GCODE_VARIABLE MACRO=_COOLDOWN_SETTINGS VARIABLE=chamber_cooled_temp VALUE=-50
COOLDOWN_SELECT MATERIAL=XYZ
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=cooldown_profile VALUE=MY_PROFILE
; ASA is in the shipped table but not in the copy, so it gets the copy's DEFAULT.
COOLDOWN_SELECT MATERIAL=ASA
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=cooldown_profile VALUE=MY_PROFILE
; A shipped profile is gone too: START_COOLDOWN refuses it and starts nothing.
START_COOLDOWN PROFILE=PASSIVE_ONLY
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=0
START_COOLDOWN PROFILE=MY_PROFILE
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=1
COOLDOWN_RESET
