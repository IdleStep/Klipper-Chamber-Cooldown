; A setting the loop would divide by is refused at START instead of stranding the loop.
SET_GCODE_VARIABLE MACRO=_COOLDOWN_SETTINGS VARIABLE=status_seconds VALUE=0
START_COOLDOWN PROFILE=HOLD_60M_COOL_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=0
SET_GCODE_VARIABLE MACRO=_COOLDOWN_SETTINGS VARIABLE=status_seconds VALUE=25
SET_GCODE_VARIABLE MACRO=_COOLDOWN_SETTINGS VARIABLE=loop_seconds VALUE=0
START_COOLDOWN PROFILE=HOLD_60M_COOL_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=0
SET_GCODE_VARIABLE MACRO=_COOLDOWN_SETTINGS VARIABLE=loop_seconds VALUE=5
SET_GCODE_VARIABLE MACRO=_COOLDOWN_SETTINGS VARIABLE=arrow_band VALUE="'x'"
START_COOLDOWN PROFILE=HOLD_60M_COOL_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=0
SET_GCODE_VARIABLE MACRO=_COOLDOWN_SETTINGS VARIABLE=arrow_band VALUE=2
START_COOLDOWN PROFILE=HOLD_60M_COOL_EX
ASSERT_VAR MACRO=_COOLDOWN_VARS VARIABLE=phase VALUE=1
COOLDOWN_RESET
